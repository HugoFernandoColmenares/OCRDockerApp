# Configuration file example
# Copy this file to .env and modify the values as needed

# Application settings
PORT=8000
FLASK_ENV=production
DEBUG=False
MAX_CONTENT_LENGTH=16777216

# OCR settings
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=spa+eng

# File processing
MAX_FILE_SIZE_MB=16
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,bmp,tiff,webp

# Storage paths
UPLOAD_FOLDER=uploads
RESULTS_FOLDER=results

# Security
# Required when FLASK_ENV=production. Do not use the development placeholder.
SECRET_KEY=replace-with-a-long-random-string
APP_PASSWORD=replace-with-an-operator-password
CORS_ORIGINS=http://localhost,http://localhost:8000

# Storage
DATABASE_PATH=data/inventory.db
MAX_STORED_UPLOADS=100
UPLOAD_MAX_AGE_DAYS=7